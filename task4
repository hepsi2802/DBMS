SELECT 
    c.category_name,
    p.product_name,
    p.price,
    p.stock
FROM Category c
JOIN Product p
ON c.category_id = p.category_id
ORDER BY c.category_name;
SELECT 
    c.category_name,
    COUNT(p.product_id) AS total_products
FROM Category c
LEFT JOIN Product p
ON c.category_id = p.category_id
GROUP BY c.category_id, c.category_name;
SELECT 
    c.category_name,
    SUM(p.stock) AS total_stock
FROM Category c
JOIN Product p
ON c.category_id = p.category_id
GROUP BY c.category_id, c.category_name;
SELECT 
    c.category_name,
    AVG(p.price) AS average_price
FROM Category c
JOIN Product p
ON c.category_id = p.category_id
GROUP BY c.category_id, c.category_name;
