USE Join_Analysis_Final;

ALTER TABLE ja_products
ADD COLUMN stock INT NOT NULL DEFAULT 50;

SELECT * FROM ja_products;

DROP PROCEDURE IF EXISTS PlaceOrder;

DELIMITER //

CREATE PROCEDURE PlaceOrder(
    IN p_customer_id INT,
    IN p_product_id INT,
    IN p_quantity INT,
    IN p_payment_method VARCHAR(50)
)
BEGIN
    DECLARE v_stock INT;
    DECLARE v_price DECIMAL(10,2);
    DECLARE v_order_id INT;
    DECLARE v_total DECIMAL(10,2);
    DECLARE v_count INT;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    START TRANSACTION;

    IF p_quantity <= 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Quantity must be greater than zero';
    END IF;

    -- Check customer
    SELECT COUNT(*) INTO v_count
    FROM ja_customers
    WHERE customer_id = p_customer_id;

    IF v_count = 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Customer does not exist';
    END IF;

    -- Check product
    SELECT COUNT(*) INTO v_count
    FROM ja_products
    WHERE product_id = p_product_id;

    IF v_count = 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Product does not exist';
    END IF;

    SELECT stock, price
    INTO v_stock, v_price
    FROM ja_products
    WHERE product_id = p_product_id
    FOR UPDATE;

    IF v_stock < p_quantity THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Insufficient stock';
    END IF;

    -- Calculate total
    SET v_total = v_price * p_quantity;

    -- Update stock
    UPDATE ja_products
    SET stock = stock - p_quantity
    WHERE product_id = p_product_id;

    -- Insert order
    INSERT INTO ja_orders
        (customer_id, order_date, order_status)
    VALUES
        (p_customer_id, NOW(), 'Placed');

    SET v_order_id = LAST_INSERT_ID();

    -- Insert order items
    INSERT INTO ja_order_items
        (order_id, product_id, quantity)
    VALUES
        (v_order_id, p_product_id, p_quantity);

    -- Insert payment
    INSERT INTO ja_payments
        (order_id, payment_date, amount,
         payment_method, payment_status)
    VALUES
        (v_order_id, NOW(), v_total,
         p_payment_method, 'Paid');

    -- Save transaction
    COMMIT;

    SELECT
        v_order_id AS order_id,
        v_total AS total_amount,
        'Order placed successfully' AS message;

END //

DELIMITER ;

CALL PlaceOrder(1, 3, 2, 'UPI');
