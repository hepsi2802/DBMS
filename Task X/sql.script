USE Join_Analysis_Final;

SELECT * FROM ja_customers;
SELECT * FROM ja_products;
SELECT * FROM ja_orders;
SELECT * FROM ja_order_items;
SELECT * FROM ja_payments;


-- =====================================================
-- 2. PRODUCTS ABOVE AVERAGE PRICE
-- SUBQUERY
-- =====================================================

SELECT
    product_id,
    product_name,
    category,
    price
FROM ja_products
WHERE price > (
    SELECT AVG(price)
    FROM ja_products
)
ORDER BY price DESC;




SELECT
    product_name,
    category,
    price
FROM ja_products
WHERE price < (
    SELECT AVG(price)
    FROM ja_products
);

SELECT
    c.customer_id,
    c.customer_name,
    SUM(oi.quantity * p.price) AS total_purchase
FROM ja_customers c
JOIN ja_orders o
    ON c.customer_id = o.customer_id
JOIN ja_order_items oi
    ON o.order_id = oi.order_id
JOIN ja_products p
    ON oi.product_id = p.product_id
GROUP BY c.customer_id, c.customer_name
HAVING SUM(oi.quantity * p.price) = (
    SELECT MAX(customer_total)
    FROM (
        SELECT
            SUM(oi2.quantity * p2.price) AS customer_total
        FROM ja_orders o2
        JOIN ja_order_items oi2
            ON o2.order_id = oi2.order_id
        JOIN ja_products p2
            ON oi2.product_id = p2.product_id
        GROUP BY o2.customer_id
    ) AS customer_sales
);


SELECT
    c.customer_id,
    c.customer_name,
    c.city,
    SUM(oi.quantity * p.price) AS total_purchase
FROM ja_customers c
JOIN ja_orders o
    ON c.customer_id = o.customer_id
JOIN ja_order_items oi
    ON o.order_id = oi.order_id
JOIN ja_products p
    ON oi.product_id = p.product_id
GROUP BY c.customer_id, c.customer_name, c.city
ORDER BY total_purchase DESC
LIMIT 5;

SELECT
    c.customer_id,
    c.customer_name,
    SUM(oi.quantity * p.price) AS total_purchase
FROM ja_customers c
JOIN ja_orders o
    ON c.customer_id = o.customer_id
JOIN ja_order_items oi
    ON o.order_id = oi.order_id
JOIN ja_products p
    ON oi.product_id = p.product_id
GROUP BY c.customer_id, c.customer_name
HAVING SUM(oi.quantity * p.price) > (
    SELECT AVG(customer_total)
    FROM (
        SELECT
            SUM(oi2.quantity * p2.price) AS customer_total
        FROM ja_orders o2
        JOIN ja_order_items oi2
            ON o2.order_id = oi2.order_id
        JOIN ja_products p2
            ON oi2.product_id = p2.product_id
        GROUP BY o2.customer_id
    ) AS average_customer_sales
);

SELECT
    p.product_id,
    p.product_name,
    SUM(oi.quantity) AS total_quantity_sold
FROM ja_products p
JOIN ja_order_items oi
    ON p.product_id = oi.product_id
GROUP BY p.product_id, p.product_name
HAVING SUM(oi.quantity) = (
    SELECT MAX(product_quantity)
    FROM (
        SELECT SUM(quantity) AS product_quantity
        FROM ja_order_items
        GROUP BY product_id
    ) AS product_sales
);

SELECT
    product_id,
    product_name,
    category,
    price
FROM ja_products p
WHERE NOT EXISTS (
    SELECT 1
    FROM ja_order_items oi
    WHERE oi.product_id = p.product_id
);

SELECT
    o.order_id,
    c.customer_name,
    SUM(oi.quantity * p.price) AS order_value
FROM ja_orders o
JOIN ja_customers c
    ON o.customer_id = c.customer_id
JOIN ja_order_items oi
    ON o.order_id = oi.order_id
JOIN ja_products p
    ON oi.product_id = p.product_id
GROUP BY o.order_id, c.customer_name
HAVING SUM(oi.quantity * p.price) > (
    SELECT AVG(order_total)
    FROM (
        SELECT
            SUM(oi2.quantity * p2.price) AS order_total
        FROM ja_orders o2
        JOIN ja_order_items oi2
            ON o2.order_id = oi2.order_id
        JOIN ja_products p2
            ON oi2.product_id = p2.product_id
        GROUP BY o2.order_id
    ) AS average_order
);


SELECT
    category,
    SUM(quantity_sold) AS total_quantity,
    SUM(category_revenue) AS total_revenue
FROM (
    SELECT
        p.category,
        oi.quantity AS quantity_sold,
        oi.quantity * p.price AS category_revenue
    FROM ja_products p
    JOIN ja_order_items oi
        ON p.product_id = oi.product_id
) AS category_report
GROUP BY category
ORDER BY total_revenue DESC;


-- =====================================================
-- 11. CUSTOMER PURCHASE HISTORY WITH NESTED QUERY
-- =====================================================

SELECT
    c.customer_id,
    c.customer_name,
    (
        SELECT COUNT(*)
        FROM ja_orders o
        WHERE o.customer_id = c.customer_id
    ) AS total_orders,
    (
        SELECT COALESCE(SUM(oi.quantity * p.price), 0)
        FROM ja_orders o
        JOIN ja_order_items oi
            ON o.order_id = oi.order_id
        JOIN ja_products p
            ON oi.product_id = p.product_id
        WHERE o.customer_id = c.customer_id
    ) AS total_spending
FROM ja_customers c
ORDER BY total_spending DESC;


SELECT
    c.customer_name,
    c.city,
    COUNT(DISTINCT o.order_id) AS total_orders,
    SUM(oi.quantity) AS total_products,
    SUM(oi.quantity * p.price) AS total_sales,
    COALESCE(SUM(DISTINCT pay.amount), 0) AS payment_amount
FROM ja_customers c
JOIN ja_orders o
    ON c.customer_id = o.customer_id
JOIN ja_order_items oi
    ON o.order_id = oi.order_id
JOIN ja_products p
    ON oi.product_id = p.product_id
LEFT JOIN ja_payments pay
    ON o.order_id = pay.order_id
GROUP BY c.customer_id, c.customer_name, c.city
ORDER BY total_sales DESC;

SELECT
    p.category,
    COUNT(DISTINCT o.order_id) AS total_orders,
    COUNT(DISTINCT o.customer_id) AS total_customers,
    SUM(oi.quantity) AS products_sold,
    SUM(oi.quantity * p.price) AS total_revenue,
    AVG(p.price) AS average_product_price,
    MIN(p.price) AS minimum_price,
    MAX(p.price) AS maximum_price
FROM ja_products p
JOIN ja_order_items oi
    ON p.product_id = oi.product_id
JOIN ja_orders o
    ON oi.order_id = o.order_id
GROUP BY p.category
ORDER BY total_revenue DESC;

SELECT
    (SELECT COUNT(*) FROM ja_customers) AS total_customers,
    (SELECT COUNT(*) FROM ja_orders) AS total_orders,
    (SELECT COUNT(*) FROM ja_products) AS total_products,
    (
        SELECT SUM(oi.quantity * p.price)
        FROM ja_order_items oi
        JOIN ja_products p
            ON oi.product_id = p.product_id
    ) AS total_revenue,
    (
        SELECT AVG(price)
        FROM ja_products
    ) AS average_product_price;
